# Forca LF em arquivos de texto, independente do core.autocrlf de quem
# commita/clona. Critico para scripts shell: um shebang com CRLF quebra
# na VM Ubuntu com "bad interpreter: /bin/bash^M: no such file or directory".
* text=auto eol=lf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf
*.md    text eol=lf
.env.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
