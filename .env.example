# Copie este arquivo para .env e ajuste os valores.
# .env NUNCA deve ser commitado (ja esta no .gitignore).
# Senhas reais NAO vao aqui - ficam em secrets/*.txt (ver docs/01-provisionamento.md).

# Banco de Dados PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak_user

# Admin Inicial do Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=kc_admin

# Dominio Publico do Keycloak (usado pelo proprio Keycloak para gerar
# links/redirects OIDC - o TLS e o roteamento por Host() ficam a cargo do
# proxy reverso/balanceador da prefeitura, que fica fora desta stack)
KC_HOSTNAME=https://sso.rondonopolis.mt.gov.br

# IP (ou faixa /CIDR) do proxy reverso da prefeitura que encaminha pra
# essa stack - OBRIGATORIO preencher, sem default. O Keycloak so confia
# no header X-Forwarded-Proto se ele vier desse endereco; sem isso
# configurado certo, os links gerados no fluxo OIDC saem como http://
# em vez de https://. Ver docs/scripts-referencia.md#proxy-reverso-externo.
PROXY_TRUSTED_ADDRESSES=

# Porta e IP de bind onde o Keycloak fica exposto no host, para o proxy
# reverso da prefeitura (que roda em outra maquina) encaminhar para ca em
# HTTP puro. Restrinja por firewall (iptables/ufw) esse IP:porta apenas ao
# endereco daquele proxy - nunca deixe aberto para a internet.
KEYCLOAK_BIND=0.0.0.0
KEYCLOAK_PORT=18443

# Active Directory (LDAPS)
AD_DOMAIN=rondonopolis.local
AD_DC_HOSTNAME=dc01.rondonopolis.local
AD_DC_IP=192.168.1.10

# Nivel de Logs
KC_LOG_LEVEL=INFO

# Imagem do Keycloak (buildada e publicada pelo CI - ver .github/workflows/ci.yml)
# Em producao, prefira travar KEYCLOAK_IMAGE_TAG num "sha-xxxxxxx" especifico
# em vez de "latest" (latest e' flutuante - reproducibilidade > conveniencia).
KEYCLOAK_IMAGE=ghcr.io/yurythx/keycloak-sso
KEYCLOAK_IMAGE_TAG=latest

# Portainer (opcional - gerenciador visual do Docker, ver docs/scripts-referencia.md)
# ENABLE_PORTAINER=true ativa o profile no deploy.sh. PORTAINER_BIND
# controla em qual IP a porta 9443 fica exposta - 127.0.0.1 (padrao) so'
# permite acesso via SSH tunnel/VPN. So mude para 0.0.0.0 se o firewall
# da prefeitura ja filtrar quem chega nessa porta.
ENABLE_PORTAINER=false
PORTAINER_BIND=127.0.0.1

# Vaultwarden (cofre de senhas) - stack separada da SSO do Keycloak
# dentro deste mesmo docker-compose.yml (banco, rede e secrets proprios -
# secrets/vw_postgres_password.txt e secrets/vw_admin_token.txt, gerados
# pelo setup.sh). O mesmo proxy reverso externo da prefeitura encaminha
# pra essas portas, igual o Keycloak - restrinja por firewall
# (iptables/ufw) ao IP daquele proxy.
#
# Autorregistro fica DESLIGADO (SIGNUPS_ALLOWED=false, fixo no
# docker-compose.yml, nao e' variavel de .env de proposito - ver revisao
# de seguranca). Contas de usuario sao criadas pelo admin no painel
# /admin (autentica com o conteudo de secrets/vw_admin_token.txt) - nao
# precisa de SMTP configurado, o link de convite aparece no log
# ("docker compose logs vaultwarden") pro admin repassar manualmente.
VW_POSTGRES_DB=vaultwarden
VW_POSTGRES_USER=vw_user
VAULTWARDEN_VERSION=latest
VAULTWARDEN_BIND=192.168.0.225
VAULTWARDEN_HTTP_PORT=8081
VAULTWARDEN_WS_PORT=3012

# URL publica do Vaultwarden - OBRIGATORIO preencher, sem default vazio.
# Achado real: com isso vazio o Vaultwarden nao sobe com funcionalidade
# limitada, ele RECUSA iniciar ("DOMAIN variable needs to contain the
# protocol") e fica em crash-loop.
VAULTWARDEN_DOMAIN=https://cofre.rondonopolis.mt.gov.br

# Login via SSO (OpenID Connect) contra o mesmo Keycloak desta stack -
# ligado por padrao nesta prefeitura (realm "prefeitura", client
# "vaultwarden" - ver docs/06-vaultwarden.md#sso pra criar esse client
# no Keycloak se ainda nao existir). O client secret NUNCA vai aqui -
# cole em secrets/vw_sso_client_secret.txt. IMPORTANTE: com
# VAULTWARDEN_SSO_ENABLED=true e o secret vazio/ausente, o Vaultwarden
# tambem RECUSA iniciar ("must be set for SSO support") - deploy.sh
# barra o deploy antes disso acontecer, mas o client precisa existir de
# verdade no Keycloak antes do primeiro deploy com SSO ligado.
VAULTWARDEN_SSO_ENABLED=true
VAULTWARDEN_SSO_AUTHORITY=https://sso.rondonopolis.mt.gov.br/realms/prefeitura
VAULTWARDEN_SSO_CLIENT_ID=vaultwarden
