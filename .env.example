# Copie este arquivo para .env e ajuste os valores.
# .env NUNCA deve ser commitado (ja esta no .gitignore).
# Senhas reais NAO vao aqui - ficam em secrets/*.txt (ver docs/01-provisionamento.md).

# Banco de Dados PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak_user

# Admin Inicial do Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=kc_admin

# Dominio Publico do Keycloak (usado pelo proprio Keycloak para gerar
# links/redirects OIDC - o TLS e o roteamento por Host() ficam a cargo do
# proxy reverso/balanceador da prefeitura, que fica fora desta stack)
KC_HOSTNAME=https://sso.rondonopolis.mt.gov.br

# IP (ou faixa /CIDR) do proxy reverso da prefeitura que encaminha pra
# essa stack - OBRIGATORIO preencher, sem default. O Keycloak so confia
# no header X-Forwarded-Proto se ele vier desse endereco; sem isso
# configurado certo, os links gerados no fluxo OIDC saem como http://
# em vez de https://. Ver docs/scripts-referencia.md#proxy-reverso-externo.
PROXY_TRUSTED_ADDRESSES=

# Porta e IP de bind onde o Keycloak fica exposto no host, para o proxy
# reverso da prefeitura (que roda em outra maquina) encaminhar para ca em
# HTTP puro. Restrinja por firewall (iptables/ufw) esse IP:porta apenas ao
# endereco daquele proxy - nunca deixe aberto para a internet.
KEYCLOAK_BIND=0.0.0.0
KEYCLOAK_PORT=18443

# Active Directory (LDAPS)
AD_DOMAIN=rondonopolis.local
AD_DC_HOSTNAME=dc01.rondonopolis.local
AD_DC_IP=192.168.1.10

# Nivel de Logs
KC_LOG_LEVEL=INFO

# Imagem do Keycloak (buildada e publicada pelo CI - ver .github/workflows/ci.yml)
# Em producao, prefira travar KEYCLOAK_IMAGE_TAG num "sha-xxxxxxx" especifico
# em vez de "latest" (latest e' flutuante - reproducibilidade > conveniencia).
KEYCLOAK_IMAGE=ghcr.io/yurythx/keycloak-sso
KEYCLOAK_IMAGE_TAG=latest

# Portainer (opcional - gerenciador visual do Docker, ver docs/scripts-referencia.md)
# ENABLE_PORTAINER=true ativa o profile no deploy.sh. PORTAINER_BIND
# controla em qual IP a porta 9443 fica exposta - 127.0.0.1 (padrao) so'
# permite acesso via SSH tunnel/VPN. So mude para 0.0.0.0 se o firewall
# da prefeitura ja filtrar quem chega nessa porta.
ENABLE_PORTAINER=false
PORTAINER_BIND=127.0.0.1
